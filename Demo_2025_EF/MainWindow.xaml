<Window x:Class="Demo_2025_EF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_2025_EF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000">
    <StackPanel> 
        
        <ScrollViewer Height="400">
            <ItemsControl x:Name="ProductsList"  Width="950">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5" Background="#BBD9B2" HorizontalAlignment="Left" Width="950">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProductType.TypeName}" Width="250" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text=" | " FontSize="14" Width="50"  FontWeight="Bold"/>
                                <TextBlock Text="{Binding ProductName}" Width="550" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Price}" />
                                <TextBlock Text=" (р)" />
                            </StackPanel>

                            <TextBlock Text="{Binding ProductId, StringFormat=Артикул: {0}}" />
                            <TextBlock Text="{Binding Size, StringFormat=Размеры: {0}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Content="Добавить товар" Width="200" Click="AddProduct_Click"/>

    </StackPanel>
</Window>
