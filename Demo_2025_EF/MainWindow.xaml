<Window x:Class="Demo_2025_EF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_2025_EF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel> 
        
        <ScrollViewer VerticalScrollBarVisibility="Visible" Height="300">
            <ItemsControl x:Name="ProductsList"  Width="600">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5" Background="#BBD9B2" HorizontalAlignment="Left" Width="600">
                            <TextBlock Text="{Binding ProductName}" />
                            <TextBlock Text="{Binding Price}" />
                            <TextBlock Text="{Binding Size}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


    </StackPanel>
</Window>
